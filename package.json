{
  "name": "acueducto-rural-upb",
  "version": "1.0.0",
  "description": "Sistema de Gestión Comunitaria de Acueducto Rural - Universidad Pontificia Bolivariana",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "Universidad Pontificia Bolivariana",
  "license": "MIT",
  "scripts": {
    "postinstall": "cd frontend && npm install && cd ../backend && npm install",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && cross-env ELECTRON=true npm run build",
    "build:backend": "cd backend && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "electron": "electron .",
    "dev": "npm run build && npm run electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "clean": "rimraf dist-electron frontend/dist backend/dist"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.7",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0"
  },
  "build": {
    "appId": "com.upb.acueducto",
    "productName": "Acueducto Rural UPB",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/node_modules/**/*",
      "node_modules/**/*",
      "!**/node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "frontend/public/icons/icon-512.png",
      "sign": null,
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "frontend/public/icons/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "frontend/public/icons/icon-512.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Acueducto Rural UPB"
    }
  }
}
